# Normalize line endings for text files; Git converts to LF in the repo and
# checks out with the platform default.
* text=auto

# Shell scripts must always use LF, even on Windows checkouts.
*.sh text eol=lf

# YAML (including GitHub Actions workflows) must always use LF.
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfiles must always use LF.
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Binary assets stay untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
