# Public Supabase configuration (safe to expose to the browser).
# For a local Docker-free backend (tinbase) or hosted Supabase, use the values
# printed by your local backend / project settings. Place real values in
# .env.local (never commit that file).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Server-only Supabase credentials. Only needed by controlled tooling such as
# the seed script. Never referenced by browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Optional: seed demo account password. When unset, the seed script uses the
# documented development default (see README).
SEED_DEMO_PASSWORD=replace-with-a-development-demo-password

# Optional: demo account email used by the seed script. supabase/seed.sql uses
# the same default (demo@cooppilot.local); change both together if customized.
SEED_DEMO_EMAIL=demo@cooppilot.local

# Application base URL (used by server-side redirects/URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
